# Copy to .env and fill in. Never commit the real .env.

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/nursing_reports

# --- Server ---
PORT=3000

# --- Certifying Authority (CA) ---
# Local dev: the CA is read from ca/ca-private-key.pem + ca/ca-certificate.pem
# (created by `npm run generate-ca`). No env vars needed locally.
#
# Production (Render): the ca/ folder is gitignored and the filesystem is
# ephemeral, so the CA MUST be injected as secret env vars instead. Paste the
# FULL PEM contents (including BEGIN/END lines). In Render, multi-line secret
# values are supported; locally you can base64-encode and set *_B64 variants.
#
# credentialService loads the CA in this order:
#   1. CA_PRIVATE_KEY_PEM / CA_CERT_PEM        (raw PEM)
#   2. CA_PRIVATE_KEY_B64 / CA_CERT_B64        (base64 of the PEM)
#   3. ca/ca-private-key.pem / ca/ca-certificate.pem   (local files)
#
# CA_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# CA_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
